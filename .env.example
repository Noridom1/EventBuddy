DATABASE_URL=postgresql+psycopg://eventbuddy:eventbuddy@localhost:5432/eventbuddy
REDIS_URL=redis://localhost:6379/0
# Phase 1.7: the conversational chat path REQUIRES these two MaaS values. Without them
# (or with AGENT_MODE=regex) EventBuddy auto-degrades to the deterministic regex router.
AGENTBASE_LLM_BASE_URL=
AGENTBASE_LLM_API_KEY=
# Model IDs are vendor-namespaced on MaaS (bare "gemma-4-31b-it"/"qwen-3-27b" 404).
LLM_CHAT_MODEL=qwen/qwen3-5-27b
LLM_SUMMARY_MODEL=qwen/qwen3-5-27b
# "llm" = LLM tool-calling brain (needs the creds above); "regex" forces the Phase 1 router.
AGENT_MODE=llm

# Bot Framework auth (CloudAdapter). APP_ID == the Client (bot) ID from IT; PASSWORD == the
# client secret; TENANT_ID == the tenant id. Single-tenant bot → these three are required.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
# Team to create event channels under (delegated: the signing-in user must be a member/owner).
MICROSOFT_TEAM_ID=

# --- Delegated Graph auth (Plan 13) — the ACTIVE path now ---------------------------------
# The OAuth Connection Setting name you create on the Azure Bot (step 2 below). Non-empty =
# delegated auth active; the bot acts on behalf of the signed-in user.
GRAPH_OAUTH_CONNECTION_NAME=eventbuddy-graph

# --- Legacy app-only Graph (client-credentials) — UNUSED while the OAuth connection is set --
# Kept only as the graceful-degradation fallback. Leave empty under delegated auth.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Unused under delegated auth (mail sends from the signed-in user's mailbox via /me/sendMail).
GRAPH_SENDER_UPN=

LOG_LEVEL=INFO
# NOTE: do NOT set GREENNODE_CLIENT_ID/SECRET/AGENT_IDENTITY/ENDPOINT_URL —
# AgentBase Runtime auto-injects these.
PENDING_ACTION_TTL=3600
FEEDBACK_FORM_URL=
FEEDBACK_WORKBOOK_URL=
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=
WEB_SEARCH_TIMEOUT=
LLM_VISION_MODEL=google/gemma-4-31b-it
LLM_VISION_ENABLED=true
CORP_EMAIL_DOMAIN=vng.com.vn
